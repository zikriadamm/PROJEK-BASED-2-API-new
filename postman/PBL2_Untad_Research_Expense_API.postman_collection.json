              "  pm.expect(pm.response.headers.get('Link')).to.include('/v2/expenses');",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('Format data v1 datar dengan konversi amountIDR', function () {",
              "  pm.expect(json.sukses).to.eql(true);",
              "  pm.expect(json.data).to.be.an('array').and.not.empty;",
              "  pm.expect(json.data[0]).to.have.property('amountIDR');",
              "  pm.expect(json.data[0]).to.not.have.property('cost');",
