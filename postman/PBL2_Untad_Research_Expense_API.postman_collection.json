    {
      "name": "TC-01 [Auth] Login Admin & Auto-Save Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code adalah 200 OK', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('Login admin berhasil mengembalikan Bearer token tanpa passwordHash', function () {",
              "  pm.expect(json.sukses).to.eql(true);",
              "  pm.expect(json.tokenType).to.eql('Bearer');",
              "  pm.expect(json.token).to.be.a('string').and.not.empty;",
              "  pm.expect(json.user).to.be.an('object');",
              "  pm.expect(json.user.role).to.eql('admin');",
              "  pm.expect(json.user).to.not.have.property('passwordHash');",
              "});",
              "",
              "if (json.token) {",
              "  pm.collectionVariables.set('adminToken', json.token);",
              "  if (pm.environment && pm.environment.name) {",
              "    pm.environment.set('adminToken', json.token);",
              "  }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          },
